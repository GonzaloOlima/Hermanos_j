#Actualización del .gitignore

# Dependencias de Node
node_modules/
jspm_packages/

# Variables de entorno (¡Muy importante para la seguridad!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de compilación y distribución (Frontend / Backend)
build/
dist/
.output/

# Logs y registros de errores
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Directorios de pruebas y cobertura
coverage/
.nyc_output/

# Configuraciones de editores de código
.vscode/
.idea/
*.swp
*.swo

# Archivos del sistema operativo
.DS_Store
Thumbs.db
